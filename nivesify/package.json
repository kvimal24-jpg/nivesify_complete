{
	"name": "nivesify",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"deploy:staging": "opennextjs-cloudflare build && npx wrangler deploy -c wrangler.staging.jsonc",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@libsql/client": "^0.17.0",
		"@opennextjs/cloudflare": "^1.15.1",
		"arctic": "^3.7.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"framer-motion": "^12.33.0",
		"idb": "^8.0.3",
		"jose": "^6.1.3",
		"lucide-react": "^0.563.0",
		"next": "16.1.5",
		"oslo": "^1.2.1",
		"pdfjs-dist": "^4.2.67",
		"react": "19.1.5",
		"react-dom": "19.1.5",
		"recharts": "^3.7.0",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.32",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"wrangler": "^4.63.0"
	}
}
